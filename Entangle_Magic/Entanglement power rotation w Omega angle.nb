   RowBox[{"Dimensions", "[", "\[Rho]a", "]"}], ",", "\"\<dim \[Rho]a\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"purity", "=", 
