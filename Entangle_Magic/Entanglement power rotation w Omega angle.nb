Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[CapitalOmega]az", "]"}], "2"]}]]}], "]"}],
         "+", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]az", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[CapitalOmega]az", "]"}], "2"]}]]}], 
           "]"}]}], 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "\[CapitalOmega]az", "]"}], "2"]}]]]}]},
      {
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[CapitalOmega]ax", 
           SqrtBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[CapitalOmega]az", "]"}], "2"]}]]], "+", 
          FractionBox[
           RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]ay"}], 
           SqrtBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
