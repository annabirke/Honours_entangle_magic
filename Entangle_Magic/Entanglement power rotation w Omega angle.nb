     RowBox[{"b", ".", "\[IndentingNewLine]", "Then"}], " ", "traces", " ", 
     "over", " ", "indices", " ", "2", " ", "and", " ", "4", " ", 
     RowBox[{"(", 
      RowBox[{"ie", " ", "j", " ", "and", " ", "l"}], ")"}], " ", "which", 
     " ", "corresp", " ", "to", " ", "particle", " ", "b"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
