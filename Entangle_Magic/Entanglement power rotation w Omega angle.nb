Cell[CellGroupData[{
Cell["Make the rotation matrices and states for particles a and b", "Subtitle",
 CellChangeTimes->{{3.980379696495019*^9, 3.980379717191345*^9}, {
  3.9804448595623274`*^9, 3.9804448937144403`*^9}, {3.980451074215481*^9, 
  3.9804510778329*^9}},ExpressionUUID->"acaaa50d-44c3-43c6-91ed-565e2ca0aefd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Pauli", " ", "matrices"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"id", " ", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmax", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmay", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "I"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigmaz", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"for", " ", "particle", " ", "a"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]a", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]ax", ",", "\[CapitalOmega]ay", ",", 
       "\[CapitalOmega]az"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"vector", " ", "describing", " ", "the", " ", "rotation"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Assumptions", "[", 
     RowBox[{
      RowBox[{"\[CapitalOmega]ax", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"\[CapitalOmega]ay", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"\[CapitalOmega]az", " ", "\[Element]", " ", "Reals"}]}], "]"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]a", "=", 
     RowBox[{"Norm", "[", "\[CapitalOmega]a", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"na", "=", 
     RowBox[{
      FractionBox["1", "\[Theta]a"], " ", "\[CapitalOmega]a"}]}], " ", ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ra", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]a", " ", "/", "2"}], "]"}], " ", "id"}], " ", "+", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]a", " ", "/", "2"}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"na", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "sigmax"}], " ", "+", 
         RowBox[{
          RowBox[{"na", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "sigmay"}], "+", 
         RowBox[{
          RowBox[{"na", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "sigmaz"}]}], ")"}]}]}]}], 
    ";"}], " ", 
   RowBox[{"(*", " ", "rotation", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "Ra", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]ina", "=", 
     RowBox[{"Ra", " ", ".", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "\[Psi]ina", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "particle", " ", "b"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]b", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]bx", ",", "\[CapitalOmega]by", ",", 
       "\[CapitalOmega]bz"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]b", "=", 
     RowBox[{"Norm", "[", "\[CapitalOmega]b", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nb", "=", 
     RowBox[{
      FractionBox["1", "\[Theta]b"], " ", "\[CapitalOmega]b"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rb", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]b", "/", "2"}], "]"}], " ", "id"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]b", "/", "2"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"nb", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "sigmax"}], "+", 
         RowBox[{
          RowBox[{"nb", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "sigmay"}], "+", 
         RowBox[{
          RowBox[{"nb", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "sigmaz"}]}], ")"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "Rb", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]inb", "=", 
     RowBox[{"Rb", ".", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "\[Psi]inb", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9803797185298023`*^9, 3.980380004520397*^9}, {
