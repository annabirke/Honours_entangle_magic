              RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"Abs", "[", "\[CapitalOmega]az", "]"}], "2"]}]]]}], 
         ")"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[CapitalOmega]ax", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "\[CapitalOmega]ay", "]"}], "2"], "+", 
