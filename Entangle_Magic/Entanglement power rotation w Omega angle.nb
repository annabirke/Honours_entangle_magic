  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]a", "=", 
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{"\[Rho]ab", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
