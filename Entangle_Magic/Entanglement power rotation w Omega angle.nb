Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]ab", "=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", "\[Psi]out", ",", 
     RowBox[{"Conjugate", "[", "\[Psi]out", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"Dimensions", "[", "\[Rho]ab", "]"}], ",", 
