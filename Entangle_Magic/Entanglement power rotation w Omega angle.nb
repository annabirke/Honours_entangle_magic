 RowBox[{"Assumptions", "[", 
  RowBox[{
   RowBox[{"\[CapitalOmega]ax", "\[Element]", 
    TemplateBox[{},
     "Reals"]}], ",", 
   RowBox[{"\[CapitalOmega]ay", "\[Element]", 
