Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Now", " ", "tensor", " ", "product", " ", "them"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]in", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"\[Psi]ina", ",", "\[Psi]inb"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]in", "=", 
     RowBox[{"Flatten", "[", "\[Psi]in", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Psi]in", "=", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"\[Psi]ina", ",", "\[Psi]inb"}], "]"}], " ", "CANT", " ", 
       "DO", " ", "THIS", " ", "BC", " ", "ELEMENTS", " ", "ARE", " ", "aL", 
       " ", "aR", " ", "bL", " ", "bR"}]}], ",", " ", "and"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "\[Psi]in", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dimensions", "[", "\[Psi]in", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ham", "=", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "+", "\[Mu]"}], ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", "a", ",", "0", ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", "0", ",", "a", ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", 
         RowBox[{"a", "+", "\[Mu]"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Ham", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"Ham", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Dimensions", "[", "Ham", "]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U", " ", "=", " ", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryJ]"}], " ", "Ham", " ", "t"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dimensions", "[", "U", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]out", "=", 
     RowBox[{"U", " ", ".", " ", "\[Psi]in"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dimensions", "[", "\[Psi]out", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
