     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{"k", ",", 
          RowBox[{"k", "+", "3"}]}], "]"}], "]"}], "*", 
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{"p", ",", 
          RowBox[{"p", "+", "3"}]}], "]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{"p", ",", 
          RowBox[{"k", "+", "3"}]}], "]"}], "]"}], "*", 
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{"k", ",", 
          RowBox[{"p", "+", "3"}]}], "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"k", "+", "3"}], ",", "k"}], "]"}], "]"}], "*", 
       RowBox[{"rho", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"p", "+", "3"}], ",", "p"}], "]"}], "]"}]}], "-", 
