Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"th1", " ", "\[Element]", "Reals"}], ",", 
      RowBox[{"ph1", " ", "\[Element]", "Reals"}], ",", 
      RowBox[{"th2", " ", "\[Element]", "Reals"}], ",", 
      RowBox[{"ph2", " ", "\[Element]", "Reals"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "first", " ", "construct", " ", "an", " ", "array", " ", "of", " ", "the", 
    " ", "single", " ", "particle", " ", "orbitals"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"orbitals", "[", 
     RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p1", "[", 
       RowBox[{"th", ",", "ph"}], "]"}], ",", " ", 
      RowBox[{"p2", "[", 
       RowBox[{"th", ",", "ph"}], "]"}], ",", " ", 
      RowBox[{"p3", "[", 
       RowBox[{"th", ",", "ph"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "construct", " ", "the", " ", "overlap", " ", "matrix", " ", "where", " ",
      "S_ij"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"<", "p_i"}], "|", 
     RowBox[{"p_j", ">"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"overlaps", "[", 
   RowBox[{"th1_", ",", "th2_", ",", "ph1_", ",", "ph2_"}], "]"}], ":=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"orbitals", "[", 
         RowBox[{"th1", ",", "ph1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], ".", 
      RowBox[{
       RowBox[{"orbitals", "[", 
        RowBox[{"th2", ",", "ph2"}], "]"}], "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{"overlaps", "[", 
    RowBox[{"th1", ",", "th2", ",", "ph1", ",", "ph2"}], "]"}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "overlap", " ", "of", " ", "2", " ", "slater", " ", 
    "determinants", " ", "is", " ", "the", " ", "determinant", " ", "of", " ",
     "this", " ", "overlap", " ", "matrix"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"slatoverlap", "[", 
   RowBox[{"th1_", ",", "th2_", ",", "ph1_", ",", "ph2_"}], "]"}], ":=", " ", 
  RowBox[{"FullSimplify", "[", 
