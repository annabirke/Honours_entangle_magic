        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"rho", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "k"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "4", ",", "6"}], "}"}]}], "]"}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
