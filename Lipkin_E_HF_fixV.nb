Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "this", " ", "is", " ", "the", " ", "expression", " ", "from", " ", 
    "Kan1980"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["N", "2"]}], " ", "\[Epsilon]", "  ", 
      RowBox[{"Cos", "[", "th", "]"}]}], "-", 
     RowBox[{
      FractionBox["V", "2"], " ", 
      FractionBox[
       RowBox[{"N", "*", 
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}]}], "2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "ph"}], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "th", "]"}], "2"]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"for", " ", "N"}], "=", 
     RowBox[{
      RowBox[{
      "3", " ", "this", " ", "is", " ", "the", " ", "same", " ", "as", " ", 
       "the", " ", "calculated", " ", "expression", " ", "above", " ", 
       "because", " ", "N", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], "/", "2"}]}], " ", "=", " ", 
      RowBox[{
      "3.", " ", "\[IndentingNewLine]", "Below", " ", "will", " ", "see", " ",
        "that", " ", "I", " ", "now", " ", "do", " ", "get", " ", "the", " ", 
       "same", " ", "thing", " ", "calculating", " ", "E", " ", "from", " ", 
       "Tr", 
       RowBox[{"(", 
        RowBox[{"rho", " ", "H"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"again", " ", "with", " ", "N"}], "=", "3"}], ")"}]}]}]}], 
    " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "p"}], "]"}], ",", "t"}], "]"}], "==", "0"}], 
       ",", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "p"}], "]"}], ",", "p"}], "]"}], "==", "0"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "p"}], "}"}]}], "]"}]}]}]], "Input",
