    "arhorho_soln = rhorho_soln - np.einsum('ijklt->ijlkt',rhorho_soln, optimize=True)\n",
    "arhorho_soln = arhorho_soln.reshape(4*P**2,4*P**2,len(soln.t))\n",
    "rho2_soln = arhorho_soln + c_soln\n",
