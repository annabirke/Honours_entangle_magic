   ],
   "source": [
    "def doubletvsDHF(P,chi,eps=1.0):\n",
    "    V = -chi*eps/(P-1)\n",
    "    a = 0.5*np.arccos(1.0/chi)\n",
    "    H = np.zeros((P+1, P+1))\n",
    "    for k in range(P+1):\n",
    "        H[k, k] = eps*(k-P/2)\n",
    "    for k in range(2, P+1):\n",
    "        H[k-2, k] = H[k, k-2] = V/2*np.sqrt(k*(P-k+1)*(k-1)*(P-k+2))\n",
    "\n",
    "    \"\"\"Lowest even-k and lowest odd-k eigenstates of a Dicke Hamiltonian.\n",
    "    H only couples k <-> k+-2, so it is block diagonal in the parity of k: diagonalise each\n",
    "    block separately and parity is guaranteed rather than inferred.\"\"\"\n",
    "    n = H.shape[0]\n",
    "    out = {}\n",
    "    for par, idx in (('S', np.arange(0, n, 2)), ('A', np.arange(1, n, 2))):\n",
    "        w, U = np.linalg.eigh(H[np.ix_(idx, idx)])\n",
    "        vec = np.zeros(n, dtype=complex)\n",
    "        vec[idx] = U[:, 0]                      # lowest state in this parity block\n",
    "        out[par] = (w[0].real, vec)\n",
    "    d = out\n",
    "    (ES, S), (EA, A) = d['S'], d['A']\n",
    "    c, s = np.cos(a), np.sin(a)\n",
    "    dhfp = np.array([np.sqrt(comb(P, k))*c**(P-k)*(s)**k for k in range(P+1)])\n",
    "    dhfm = np.array([np.sqrt(comb(P, k))*c**(P-k)*(-s)**k for k in range(P+1)])\n",
    "    # eigenvector signs are arbitrary: fix both to have positive overlap with DHF+\n",
    "    S = S*np.sign((S.conj() @ dhfp).real)\n",
    "    A = A*np.sign((A.conj() @ dhfp).real)\n",
    "\n",
    "    ovlpp = abs(S.conj()@dhfp)**2 + abs(A.conj()@dhfp)**2\n",
    "    ovlpm = abs(S.conj()@dhfm)**2 + abs(A.conj()@dhfm)**2\n",
    "    return ovlpp, ovlpm\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(12, 4), sharex=True)\n",
    "for i, P_scan in enumerate([2,4,6,8,10]):\n",
    "    chi_scan_list = np.linspace(1.01,10,500)\n",
    "    ovlpp_list = []\n",
    "    ovlpm_list = []\n",
    "    for chi_scan in chi_scan_list:\n",
    "        ovlpp, ovlpm = doubletvsDHF(P_scan,chi_scan)\n",
    "        ovlpp_list.append(np.abs(ovlpp))\n",
    "        ovlpm_list.append(np.abs(ovlpm))\n",
    "    ovlpp_list=np.asarray(ovlpp_list)\n",
    "    ovlpm_list=np.asarray(ovlpm_list)\n",
    "    ax[0].plot(chi_scan_list, ovlpp_list, color=colours[i],label=f'N{P_scan}')\n",
    "    ax[1].plot(chi_scan_list, ovlpm_list, color=colours[i],label=f'N{P_scan}')\n",
    "    # ax[2].plot(chi_scan_list,ovlpp_list-ovlpm_list, color=colours[i],label=f'N{P_scan}')\n",
    "ax[0].set_ylabel(r'$|\\langle +\\mathrm{DHF}| \\ \\frac{(S+A)}{\\sqrt{2}} \\rangle|^2$')\n",
    "ax[1].set_ylabel(r'$|\\langle -\\mathrm{DHF}| \\ \\frac{(S-A)}{\\sqrt{2}} \\rangle|^2$')\n",
    "ax[0].set_xlabel(r'$\\chi$')\n",
    "ax[1].set_xlabel(r'$\\chi$')\n",
    "ax[0].set_xlim(0.7,10.3)\n",
    "ax[1].set_xlim(0.7,10.3)\n",
    "# ax[0].set_ylim(0,1)\n",
    "# ax[1].set_ylim(0,1)\n",
    "ax[0].legend()\n",
    "# plt.legend()\n",
    "# plt.yscale('log')\n",
    "# plt.savefig(f'C:/Users/annas/Documents/2026/Honours/Thesis/Figures/TDDM_figures/tddm_doubletsvsDHF_overlap.eps',bbox_inches='tight',dpi=300)\n",
    "plt.show()\n"
   ]
  },
