   "source": [
    "\"\"\" Physicality diagnostics: eigenvalues of rho1 and rho2 over time.\n",
    "\n",
    "rho1 occupations must lie in [0,1].  rho2 must be positive semi-definite on the\n",
    "antisymmetric pair subspace -- a much stronger condition.  For a Slater start, rho2 has\n",
    "C(P,2) eigenvalues equal to 2 and all the rest EXACTLY 0, so they sit on the positivity\n",
    "boundary from t=0 and TDDM pushes them negative immediately (growing as O(t^4), i.e. the\n",
    "C3 truncation error).  rho1's occupations instead move inward, away from 0 and 1, which\n",
    "is why they survive far longer.\n",
    "\n",
    "So: use the rho1 panel as the practical validity cutoff, and the rho2 panels as a\n",
    "quantitative measure of how far the truncation has drifted off the physical manifold.\n",
    "Set stride > 1 to subsample time for large P.\n",
    "\"\"\"\n",
    "\n",
    "def rho1_evals_t(n, stride=1):\n",
    "    \"\"\"(2P,2P,T) -> (2P, T') occupation numbers, ascending.\"\"\"\n",
    "    nh = 0.5*(n + n.conj().transpose(1, 0, 2))[:, :, ::stride]\n",
    "    return np.array([np.linalg.eigvalsh(nh[:, :, t]) for t in range(nh.shape[-1])]).T\n",
    "\n",
    "def rho2_evals_t(rho2, stride=1):\n",
    "    \"\"\"(4P^2,4P^2,T) -> (M(M-1)/2, T') eigenvalues on the antisym pair subspace.\"\"\"\n",
    "    M = int(round(np.sqrt(rho2.shape[0])))\n",
    "    pairs = [(i, j) for i in range(M) for j in range(i+1, M)]\n",
    "    A = np.zeros((M*M, len(pairs)))\n",
    "    for q, (i, j) in enumerate(pairs):\n",
    "        A[i*M+j, q], A[j*M+i, q] = 2**-0.5, -2**-0.5\n",
    "    out = []\n",
    "    for t in range(0, rho2.shape[-1], stride):\n",
    "        D = 0.5*(rho2[:, :, t] + rho2[:, :, t].conj().T)\n",
    "        out.append(np.linalg.eigvalsh(A.T @ D @ A))\n",
    "    return np.array(out).T\n",
    "\n",
    "def first_below(x, tlist, tol=1e-10):\n",
    "    bad = np.where(x < -tol)[0]\n",
    "    return tlist[bad[0]] if bad.size else None\n",
    "\n",
    "stride = 1\n",
    "tt  = soln.t[::stride]\n",
    "ev1 = rho1_evals_t(rho_soln, stride)\n",
    "ev2 = rho2_evals_t(rho2_soln, stride)\n",
    "margin1 = np.minimum(ev1.min(0), 1.0 - ev1.max(0))   # > 0 while occupations are inside [0,1]\n",
    "\n",
    "t1 = first_below(margin1, tt)\n",
    "t2 = first_below(ev2.min(0), tt)\n",
    "print(f'ev2 shape: {ev2.shape}')\n",
    "print(f'rho1 occupations leave [0,1] at t = {t1}')\n",
    "print(f'rho2 loses positivity at        t = {t2}')\n",
    "print(f'rho2 most negative eigenvalue   = {ev2.min():.3e}  (trace = {ev2[:,0].sum():.3f} = P(P-1))')\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10,4))\n",
    "# plt.hspan(min(-0.2, ev2.min()*1.2), 0.0, color='0.92')\n",
    "plt.plot(tt, ev2.T) # ev2.T has shape (T, n_evlas), plots one line per column\n",
    "plt.hlines(0, xmin=tt[0], xmax=tt[-1],color='k',linestyle='--')\n",
    "plt.ylabel(r'Eigenvalues of $\\rho^{(2)}$')\n",
    "plt.xlabel('Time')\n",
    "plt.xlim(-1,41.5)\n",
    "plt.savefig(f'C:/Users/annas/Documents/2026/Honours/Thesis/Figures/TDDM_figures/TDDM_rho2evals_N{P}_chi{chi}_V{V}.eps',bbox_inches='tight',dpi=300)\n",
    "plt.show()\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(4, 1, figsize=(8, 12), sharex=True)\n",
    "ax[0].axhspan(1.0, 1.2, color='0.92'); ax[0].axhspan(-0.2, 0.0, color='0.92')\n",
    "ax[0].plot(tt, ev1.T, lw=1)\n",
    "ax[0].axhline(0, color='k', lw=0.8); ax[0].axhline(1, color='k', lw=0.8)\n",
    "ax[0].set_ylim(-0.2, 1.2)\n",
    "ax[0].set_ylabel(r'eigenvalues of $\\rho_1$')\n",
    "ax[0].set_title(r'physical requires: $\\rho_1$ eigenvalues in [0,1]  and  $\\rho_2 \\succeq 0$', fontsize=10)\n",
    "\n",
    "ax[1].axhspan(min(-0.2, ev2.min()*1.2), 0.0, color='0.92')\n",
    "ax[1].plot(tt, ev2.T, lw=0.8) # ev2.T has shape (T, n_evlas), plots one line per column\n",
    "ax[1].axhline(0, color='k', lw=0.8)\n",
    "ax[1].set_ylabel(r'eigenvalues of $\\rho_2$')\n",
    "\n",
    "ax[2].plot(tt, ev2.min(0), color='crimson', lw=1.3)\n",
    "# ax[2].plot(tt, ev2.max(0), color='b', lw=1.3)\n",
    "ax[2].axhline(0, color='k', lw=0.8)\n",
    "ax[2].set_yscale('symlog', linthresh=1e-10)\n",
    "ax[2].set_ylabel(r'min eigenvalue of $\\rho_2$')\n",
    "ax[2].set_xlabel('Time')\n",
    "\n",
    "ax[3].plot(tt, 100*ev2.min(0)/ev2.max(0), color='crimson', lw=1.3)\n",
    "# ax[3].axhline(0, color='k', lw=0.8)\n",
    "# ax[3].set_yscale('symlog', linthresh=1e-10)\n",
    "ax[3].set_ylabel(r'% of min vs max eval of $\\rho_2$')\n",
    "ax[3].set_xlabel('Time')\n",
    "\n",
    "for a in ax:\n",
    "    if t1 is not None: a.axvline(t1, color='tab:blue', ls='--', lw=1.2)\n",
    "    if t2 is not None: a.axvline(t2, color='crimson', ls=':', lw=1.2)\n",
    "ax[0].plot([], [], color='tab:blue', ls='--', lw=1.2,\n",
    "           label=(f'$\\\\rho_1$ leaves [0,1]: t = {t1:.2f}' if t1 is not None else r'$\\rho_1$ stays in [0,1]'))\n",
    "ax[0].plot([], [], color='crimson', ls=':', lw=1.2,\n",
    "           label=(f'$\\\\rho_2$ loses positivity: t = {t2:.2f}' if t2 is not None else r'$\\rho_2$ stays $\\succeq$ 0'))\n",
    "ax[0].legend(loc='center right', fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
