   "source": [
    "''' check no unphysical states in the solution '''\n",
    "\n",
    "def check_unphys(n,tlist):\n",
    "    for t, time in enumerate(tlist):\n",
    "        ev = np.linalg.eigvalsh(0.5*(n[:,:,t] + n[:,:,t].conj().T))\n",
    "        if min(ev.min(), 1.0 - ev.max()) >= -1e-10: continue \n",
    "        else:\n",
    "            print('unphysical (bc evals) from t=',time,', evals:',ev)\n",
    "            break \n",
    "    print('done')\n",
    "\n",
    "def check_unphys2(rho2, tlist, tol=1e-3):\n",
    "    M = int(round(np.sqrt(rho2.shape[0])))              # M = 2N\n",
    "    pairs = [(i, j) for i in range(M) for j in range(i + 1, M)]\n",
    "    A = np.zeros((M * M, len(pairs)))                   # antisym pair basis\n",
    "    for q, (i, j) in enumerate(pairs):\n",
    "        A[i * M + j, q], A[j * M + i, q] = 2**-0.5, -2**-0.5\n",
    "    for t, time in enumerate(tlist):\n",
    "        D = 0.5 * (rho2[:, :, t] + rho2[:, :, t].conj().T)\n",
    "        ev = np.linalg.eigvalsh(A.T @ D @ A)\n",
    "        if ev.min() >= -tol: continue\n",
    "        else:\n",
    "            print('unphysical (bc rho2 evals) from t=', time, ', evals:', ev)\n",
    "            break\n",
    "    print('done')\n",
    "\n",
    "check_unphys(rho_soln,soln.t)\n",
    "check_unphys2(rho2_soln,soln.t)"
   ]
  },
