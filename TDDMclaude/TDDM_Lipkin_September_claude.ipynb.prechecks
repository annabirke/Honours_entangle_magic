   "source": [
    "''' Exact evolution for parameter scans.\n",
    "\n",
    "exact_dicke derives V and the DHF angle from its own arguments and reads no globals, so a\n",
    "scan cannot leave P, chi, V or a_dhf in an inconsistent state. Use local names for the\n",
    "scan values (not P, chi or t_list) so the main calculation above is untouched.\n",
    "'''\n",
    "def exact_dicke(P, chi, t_list, eps=1.0, sign=+1):\n",
    "    \"\"\"Exact evolution from the DHF minimum. Returns (psiout (P+1,T), <N_DHF+>(t)).\"\"\"\n",
    "    V = -chi*eps/(P-1)\n",
    "    a = 0.5*np.arccos(1.0/chi)\n",
    "    H = np.zeros((P+1, P+1))\n",
    "    for k in range(P+1):\n",
    "        H[k, k] = eps*(k-P/2)\n",
    "    for k in range(2, P+1):\n",
    "        H[k-2, k] = H[k, k-2] = V/2*np.sqrt(k*(P-k+1)*(k-1)*(P-k+2))\n",
    "    w, U = np.linalg.eigh(H)\n",
    "    print('estate doublet1', np.array2string(U[:,0].real, precision=4, suppress_small=True))\n",
    "    print('estate doublet2', np.array2string(U[:,1].real, precision=4, suppress_small=True))\n",
    "\n",
    "    c, s = np.cos(a), sign*np.sin(a)\n",
    "    psi0 = np.array([np.sqrt(comb(P, k))*c**(P-k)*s**k for k in range(P+1)])\n",
    "    psiout = U @ (np.exp(-1j*np.outer(w, t_list)) * (U.T @ psi0)[:, None])\n",
    "    ''' energy splitting '''\n",
    "    delE = w[1]-w[0]\n",
    "    # print(f'splitting = {delE:.6e},  next gap / splitting = {(w[2]-w[1])/delE:.1f}')\n",
    "    if delE < 1e-10*abs(w[0]):\n",
    "        print('WARNING: splitting is near float64 resolution -- use split_mp(P, chi)')\n",
    "    return psiout, DHFobservable_dicke(a, trdicke_psi(psiout, 1)).real, delE\n",
    "\n",
    "# scan over particle number at fixed chi\n",
    "ts_scan = np.linspace(0.0, 50.0, 1001)\n",
    "chi_scan = 4\n",
    "for P_scan in [4, 6, 8, 10]:\n",
    "    _, nDHF_scan, _ = exact_dicke(P_scan, chi_scan, ts_scan)\n",
    "    plt.plot(ts_scan, nDHF_scan/P_scan, label=f'N{P_scan},chi{chi_scan}')\n",
    "plt.ylabel(r'$\\langle \\mathrm{DHF}(+\\theta_0)\\rangle / N$')\n",
    "plt.xlabel('Time')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
