   "source": [
    "\"\"\"\n",
    "And now we integrate\n",
    "\"\"\"\n",
    "\n",
    "''' t_list already exists, use same one '''\n",
    "# t_list = np.linspace(0.0,5.0,201)\n",
    "soln_tdhf = solve_ivp( \n",
    "    fun=TDHF,\n",
    "    t_span = (t_list[0],t_list[-1]), \n",
    "    y0 = y0,\n",
    "    t_eval = t_list,\n",
    "    method = \"RK45\", # BDF  DOP853\n",
    "    rtol=1e-9,\n",
    "    atol=1e-11,\n",
    ")\n",
    "\n",
    "if not soln_tdhf.success:\n",
    "    raise RuntimeError(\n",
    "        f\"Integration failed: {soln_tdhf.message}\"\n",
    "    )"
   ]
  },
