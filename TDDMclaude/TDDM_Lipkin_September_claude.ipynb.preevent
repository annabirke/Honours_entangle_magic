    "\n",
    "# def TDHFold(t,y):\n",
    "#     rho = y.reshape(2*P,2*P)\n",
    "#     d_rho = np.zeros_like(rho,dtype=complex)\n",
    "\n",
    "#     h0 = np.zeros((2*P,2*P),dtype=complex)\n",
    "#     for i in range(-P,P):\n",
    "#         if i==0:\n",
    "#             h0[i+P,i+P] = eps/2 * 1\n",
    "#         else:\n",
