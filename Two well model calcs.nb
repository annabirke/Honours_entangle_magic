 RowBox[{"expectN", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "state", "]"}], ".", "NN", " ", ".", 
